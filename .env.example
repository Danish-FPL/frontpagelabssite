# Copy to .env (gitignored) for local work, and mirror in the Netlify
# dashboard (Site settings → Environment variables) for production.
#
# All three power netlify/functions/submit-lead.mjs — the /api/lead endpoint
# every site form posts to. Until they are set, forms still "succeed" for the
# visitor but nothing is stored (placeholder mode).

# Airtable personal access token — create at https://airtable.com/create/tokens
# Scopes: data.records:read + data.records:write on the leads base only.
AIRTABLE_API_KEY=pat_REPLACE_ME

# The FrontPage Labs leads base (the app… id from the base URL).
AIRTABLE_BASE_ID=app_REPLACE_ME

# Table name or tbl… id. Suggested columns: Source, Page, Name, Email, Phone,
# Website, Business, Message, Frustration, Goal, Channel, Submitted (date).
AIRTABLE_LEADS_TABLE=Leads
