# Copy to .env (gitignored) for local work, and mirror in the Netlify
# dashboard (Site settings → Environment variables) for production.
#
# All three power netlify/functions/submit-lead.mjs — the /api/lead endpoint
# every site form posts to. Until they are set, forms still "succeed" for the
# visitor but nothing is stored (placeholder mode).

# Airtable personal access token — create at https://airtable.com/create/tokens
# Scopes: data.records:read + data.records:write on the leads base only.
AIRTABLE_API_KEY=pat_REPLACE_ME

# The FrontPage Labs leads base (the app… id from the base URL).
AIRTABLE_BASE_ID=app_REPLACE_ME

# Table name or tbl… id. Suggested columns: Source, Page, Name, Email, Phone,
# Website, Business, Message, Frustration, Goal, Channel, Submitted (date).
AIRTABLE_LEADS_TABLE=Leads

# ─── Growth Command (dashboard/, local only, never deployed) ────────────────
# Prospects and the touch log live in the SAME base as Leads, in two more
# tables. Names or tbl… ids. Until AIRTABLE_API_KEY + AIRTABLE_BASE_ID are set
# the dashboard keeps everything in dashboard/data/*.json instead.
AIRTABLE_PROSPECTS_TABLE=Prospects
AIRTABLE_TOUCHES_TABLE=Touches

# Drafting ONLY. The dashboard never sends anything; Claude writes a draft and
# Danish sends it by hand. About 2 cents a draft. Leave empty to run with the
# fill-in templates instead. Set a monthly spend cap on the key in the console.
ANTHROPIC_API_KEY=
FPL_DRAFT_MODEL=claude-sonnet-5

# Web-search research of public business info ("property managers in
# Naperville"). Off by default because each search costs 5 to 15 cents.
FPL_RESEARCH_ENABLED=0

# Daily caps on NEW first touches (follow-ups never count). The settings
# popover in the dashboard overrides these and remembers the override.
FPL_CAP_TOTAL=15
FPL_CAP_EMAIL=7
FPL_CAP_LINKEDIN=4
FPL_CAP_INSTAGRAM=3
FPL_CAP_CALL=1

# Dashboard access. Change the PIN before pointing this at real data.
FPL_DASH_PIN=
FPL_DASH_PORT=4787
FPL_DASH_STAFF=Danish
