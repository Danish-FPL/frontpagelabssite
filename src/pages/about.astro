---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<Base title="About | FrontPageLabs - Digital Performance, Down to a Science.">
  <!-- Hero -------------------------------------------------------------- -->
  <section class="section-top">
    <div class="container-fluid">
      <div class="page-title-wrapper">
        <div class="overflow-hidden">
          <h1 class="page-title">meet</h1>
        </div>
        <div class="overflow-hidden">
          <h1 class="page-title">FrontPage<span class="text-wolf-grey">labs</span></h1>
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning statement --------------------------------------------- -->
  <section class="section intro">
    <div class="container-fluid">
      <div class="intro-inner">
        {/* Inline tags stay on the same line as adjoining text — Astro trims
            whitespace at expression/element boundaries, which eats the space. */}
        <p class="paragraph-extra-large wdd no-text-indent">
          We partner with ambitious brands to build full-scale marketing systems that <strong>engage</strong> and <strong>convert</strong>.
        </p>
        <p class="paragraph-extra-large wdd no-text-indent">
          <span class="text-wolf-grey">Standard marketing</span> yields <span class="text-wolf-grey">standard results</span>;<br />
          Our approach layers strategic design, calibrated outreach and tailored strategy
          into one synchronized growth engine.
        </p>
        <p class="paragraph-extra-large wdd no-text-indent">
          We don't settle at shiny websites or arbitrary brand reach stats;<br />
          We create stark brand identities that land gracefully in front of the right audience.
        </p>
        <p class="paragraph-extra-large wdd no-text-indent">
          <strong>We are your dedicated growth operators.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- (01) Meet the Founder ---------------------------------------------- -->
  <section class="section founder" id="founder">
    <div class="container">
      <div class="about-grid">
        <SectionTitle number="(01)" label="Meet the Founder" />

        <div class="about-section-content-inner">
          <div class="margin-bottom-medium">
            <h2 class="heading-small about">About the founder</h2>
          </div>

          <div class="about-section-bottom">
            <p class="paragraph-large dana no-text-indent">
              <strong>Hello! My name is Danish, and I lead FrontPage Labs.</strong>
            </p>
            <p class="paragraph-large dana">
              I was born and raised in Chicago, where the city's architecture and rich culture
              drew me into an early obsession with design and business.
            </p>
            <p class="paragraph-large dana">
              What started as a web design side-gig in college has grown into a full service
              marketing studio. Now, FrontPage Labs partners with ambitious brands to create
              lasting, cohesive marketing systems primed for growth.
            </p>
            <p class="paragraph-large dana no-text-indent">
              <strong>A quick background on me:</strong>
            </p>
            <p class="paragraph-large dana">
              I studied finance at the University of Iowa and built websites between classes to
              cover tuition. At the same time, I built and led the internal market research
              department at a large Chicago architectural firm, a role I started in high school
              and continued for five years.
            </p>
            <p class="paragraph-large dana">
              After getting my degree, I spent three years as a strategic consultant at the
              country's leading commercial real estate company, advising large corporations and
              governmental entities on real estate portfolio optimization.
            </p>
            <p class="paragraph-large dana">
              Years of varied analytical and entrepreneurial roles revealed an intrinsic ability
              and interest in something that still excites me today:
              <strong>the science of growing businesses</strong>.
            </p>
          </div>
        </div>

        <div class="founder-images">
          <img class="founder-image" src="/assets/3.0-fpl-intro-finals-8-.png" alt="Danish, founder of FrontPage Labs" />
        </div>
      </div>
    </div>
  </section>

  <!-- (02) We like good design ------------------------------------------- -->
  <section class="section design">
    <div class="container">
      <div class="about-grid">
        <SectionTitle number="(02)" label="We like good design" />

        <div class="about-section-content-inner">
          <div class="margin-bottom-medium">
            <h2 class="heading-small about">
              We like building stuff that <span class="text-wolf-grey">looks good</span> and works.
            </h2>
          </div>

          <div class="about-section-bottom">
            <p class="paragraph-large dana no-text-indent">Our core brand-building elements are simple:</p>
            <p class="paragraph-large dana no-text-indent">
              1. A sharp digital foundation to reflect your brand's purpose and offer.
              (<strong>websites + channels</strong>)
            </p>
            <p class="paragraph-large dana no-text-indent">
              2. A bridge to in-market strangers. (<strong>ads</strong>)
            </p>
            <p class="paragraph-large dana no-text-indent">
              3. A clear blueprint to guide every tool you deploy. (<strong>strategies</strong>)
            </p>

            <div class="margin-bottom-medium button-row">
              <Button href="/services" label="View Our Services" />
            </div>
          </div>
        </div>

        <div class="design-image">
          <img src="/assets/10.png" alt="" />
        </div>
      </div>
    </div>
  </section>

  <!-- (03) Know your market(ing) ------------------------------------------ -->
  <section class="section mission">
    <div class="container">
      <div class="section-title-row">
        <h2 class="section-title-text">Know your market(ing)</h2>
        <div class="section-title-text">(03)</div>
      </div>
      <div class="divider"></div>
    </div>

    <div class="overflow-hidden">
      <div class="container-fluid">
        <div class="mission-heading-wrapper">
          <h3 class="heading-large">success</h3>
          <div class="mission-heading-number">001</div>
        </div>

        <div class="align-right">
          <div class="mission-heading-wrapper">
            <div class="mission-heading-number left">002</div>
            <h3 class="heading-large">leaves</h3>
          </div>
        </div>

        <div class="mission-heading-wrapper margin-left center">
          <h3 class="heading-large">clues</h3>
          <div class="mission-heading-number">003</div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="mission-bottom">
        <div class="mission-image">
          <img src="/assets/fpl-16-.png" alt="" />
        </div>
        <div class="mission-text">
          <p class="paragraph-small">
            Every industry leaves a trail of what works and what doesn't, and buried in that data
            are the <strong>clues to your advantage</strong>.
          </p>
          <p class="paragraph-small">
            We decode those signals, then position your brand to sit where the market is headed.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-top {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .intro-inner {
    max-width: 46rem;
    margin-inline: auto;
    display: grid;
    gap: 1.5rem;
  }

  /* Vertical section label | body copy | image */
  .about-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 2rem;
    align-items: start;
  }

  .about-section-bottom {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .founder-images {
    position: relative;
  }

  .founder-image {
    width: 100%;
    height: auto;
  }

  .design-image img {
    width: 100%;
  }

  .button-row {
    margin-top: 1.25rem;
  }

  /* --- Mission ---------------------------------------------------------- */

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .divider {
    height: 1px;
    background-color: var(--color-border-muted);
  }

  .mission {
    padding-top: 6rem;
  }

  .mission-heading-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .mission-heading-wrapper.center {
    justify-content: center;
  }

  .mission-heading-number {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding-top: 0.4rem;
  }

  .mission-bottom {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
    margin-top: 3rem;
  }

  .mission-text {
    display: grid;
    gap: 1rem;
    max-width: 28rem;
    justify-self: end;
  }

  @media (max-width: 991px) {
    .about-grid {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .founder-images,
    .design-image {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .mission-bottom {
      grid-template-columns: 1fr;
    }

    .mission-text {
      justify-self: start;
    }
  }
</style>
