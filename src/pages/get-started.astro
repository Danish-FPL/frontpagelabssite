---
// /get-started — the catch-all registration sequence every "Get Started"
// button on the site lands on. Four quick cards, one visible at a time,
// modelled on the website-audit questionnaire's state machine (and CAF's
// register flow), styled entirely in the site's own type and card language.
//
//   1. Goals            — multi-select option cards
//   2. Current presence — website / social links (optional)
//   3. Budget           — single-select, click advances
//   4. Email + phone    — submit → /api/lead (Airtable), success card
//
// Answers post to /api/lead with source "Get started". Goals ride the Goal
// column, links ride Website, and budget rides Message ("Budget: …") so no
// new Airtable column is needed.
//
// META PIXEL: paste the pixel ID below and every step fires a trackable
// event (PageView, GetStartedStep 1–4, Lead on submit). Empty ID = no pixel
// script is injected at all.
//
// STRIPE: the success card is where the payment step will slot in — swap
// the copy/CTA there once the Stripe payment page details exist.
//
// Same deliberate choice as the audit page: a self-contained shell with no
// Nav/Footer, so nothing competes with finishing the sequence.
import '../styles/global.css';
import { testimonials } from '../data/testimonials';

const META_PIXEL_ID = ''; // ← paste the Meta pixel ID here to turn tracking on
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Get Started | FrontPageLabs</title>
    <meta name="description" content="Four quick questions and we'll come back with a plan and a price." />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="preload" href="/fonts/overusedgrotesk-semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/overusedgrotesk-medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="q" data-step="1">
      <header class="q-header">
        <a class="q-logo" href="/" aria-label="Back to FrontPage Labs">
          <img src="/assets/frontpage-labs-logo-1-.png" alt="FrontPage Labs" width="180" />
        </a>

        <div class="q-header-actions">
          <button class="q-mini" type="button" data-strip-toggle="call" aria-expanded="false" aria-controls="strip-call">
            Questions? Call us
          </button>
          <button class="q-mini" type="button" data-strip-toggle="pricing" aria-expanded="false" aria-controls="strip-pricing">
            Pricing
          </button>
        </div>
      </header>

      {/* Drawer strips — tiny banners that slide open under the header. */}
      <div class="q-strip" id="strip-call" data-strip="call">
        <div class="q-strip-clip">
          <p class="q-strip-content">
            Call us at <a href="tel:+18477570201">847-757-0201</a>
          </p>
        </div>
      </div>
      <div class="q-strip" id="strip-pricing" data-strip="pricing">
        <div class="q-strip-clip">
          <p class="q-strip-content">
            Plans start at <span class="q-strip-accent">$40 a month</span> or a{' '}
            <span class="q-strip-accent">$1,899 flat fee</span>.
          </p>
        </div>
      </div>

      <div class="q-body">
        {/* The bars double as navigation: each one jumps back to its step. */}
        <div class="q-progress">
          <span class="q-progress-label" aria-hidden="true">Step <span data-step-num>1</span> of 4</span>
          <div class="q-progress-bar">
            <button type="button" data-goto="1" aria-label="Go to step 1: your industry"></button>
            <button type="button" data-goto="2" aria-label="Go to step 2: your biggest challenge"></button>
            <button type="button" data-goto="3" aria-label="Go to step 3: your budget"></button>
            <button type="button" data-goto="4" aria-label="Go to step 4: your contact details"></button>
          </div>
        </div>

        {/* Card 1 — industry */}
        <section class="q-card" data-card="1">
          <h1 class="q-question">What industry are you in?</h1>
          <p class="q-helper">
            Tell us what company you run. Details like where you're located and who you serve are
            helpful, too.
          </p>
          <div class="q-field">
            <label class="sr-only" for="q-industry">Your industry or type of company</label>
            <input
              id="q-industry"
              name="industry"
              type="text"
              placeholder="Family-run plumbing company in Naperville, serving homeowners"
              required
            />
            <p class="q-error" aria-live="polite"></p>
          </div>
          <div class="q-nav">
            <button class="q-next" type="button" data-next>Next</button>
          </div>
        </section>

        {/* Card 2 — challenge */}
        <section class="q-card" data-card="2" hidden aria-hidden="true">
          <h2 class="q-question">What's the biggest challenge in growing right now?</h2>
          <p class="q-helper">Say it plainly. The clearer the problem, the better the plan.</p>
          <div class="q-field">
            <label class="sr-only" for="q-challenge">Your biggest growth challenge</label>
            <textarea
              id="q-challenge"
              name="challenge"
              rows="3"
              placeholder="Nobody finds us online, our site never brings in work, ads cost too much…"
              required></textarea>
            <p class="q-error" aria-live="polite"></p>
          </div>
          <div class="q-nav">
            <button class="q-back" type="button" data-back>Back</button>
            <button class="q-next" type="button" data-next>Next</button>
          </div>
        </section>

        {/* Card 3 — budget (single-select, click advances) */}
        <section class="q-card" data-card="3" hidden aria-hidden="true">
          <h2 class="q-question">What's your budget?</h2>
          <p class="q-helper">A ballpark is fine. It only shapes what we recommend first.</p>

          <div class="q-options" data-single>
            <button class="q-option" type="button" data-option="Under $500">
              <span class="q-option-label">Under $500</span>
              <span class="q-option-mark" aria-hidden="true"></span>
            </button>
            <button class="q-option" type="button" data-option="$500 – $2,000">
              <span class="q-option-label">$500 – $2,000</span>
              <span class="q-option-mark" aria-hidden="true"></span>
            </button>
            <button class="q-option" type="button" data-option="$2,000 – $5,000">
              <span class="q-option-label">$2,000 – $5,000</span>
              <span class="q-option-mark" aria-hidden="true"></span>
            </button>
            <button class="q-option" type="button" data-option="$5,000+">
              <span class="q-option-label">$5,000+</span>
              <span class="q-option-mark" aria-hidden="true"></span>
            </button>
            <button class="q-option" type="button" data-option="Not sure yet">
              <span class="q-option-label">Not sure yet</span>
              <span class="q-option-mark" aria-hidden="true"></span>
            </button>
          </div>
          <p class="q-error" data-options-error aria-live="polite"></p>

          <div class="q-nav">
            <button class="q-back" type="button" data-back>Back</button>
          </div>
        </section>

        {/* Card 4 — contact + submit */}
        <section class="q-card" data-card="4" hidden aria-hidden="true">
          <h2 class="q-question">Where do we reach you?</h2>
          <p class="q-helper">We'll come back with a plan and a price, usually within one business day.</p>
          <div class="q-field">
            <label for="q-email">Email</label>
            <input id="q-email" name="email" type="email" autocomplete="email" placeholder="you@business.com" required />
            <p class="q-error" aria-live="polite"></p>
          </div>
          <div class="q-field">
            <label for="q-phone">Phone</label>
            <input id="q-phone" name="phone" type="tel" autocomplete="tel" placeholder="(000) 000-0000" required />
            <p class="q-error" aria-live="polite"></p>
          </div>
          <div class="q-nav">
            <button class="q-back" type="button" data-back>Back</button>
            <button class="q-next" type="button" data-submit>Get started</button>
          </div>
        </section>

        {/* Success — the Stripe payment step will slot in here */}
        <section class="q-done" hidden aria-hidden="true">
          <h2 class="q-question">You're on the FrontPage.</h2>
          <p class="q-helper" data-done-copy>
            We've got your industry, your challenge, and your budget. Expect to hear from us within
            one business day.
          </p>
          <div class="q-nav">
            <a class="q-next q-done-link" href="/">Back to the site</a>
          </div>
        </section>

        {/* Floating proof — one client quote at a time, cross-fading as the
             visitor moves through the steps, so every answer lands next to a
             reason to keep going. */}
        {/* Exit intent: one offer, one time, with a live countdown. */}
        <div class="q-modal" data-modal="exit" hidden>
          <div class="q-modal-backdrop" data-modal-close></div>
          <div class="q-modal-panel" role="dialog" aria-modal="true" aria-labelledby="exit-title">
            <button class="q-modal-x" type="button" data-modal-close aria-label="Close">&times;</button>
            <p class="q-modal-eyebrow">Before you go</p>
            <h2 class="q-modal-title" id="exit-title">Here's 15% off.</h2>
            <p class="q-modal-copy" data-exit-copy>
              Finish your answers and it's yours. Valid for the next
              <span class="q-modal-clock" data-exit-clock>15:00</span>.
            </p>
            <p class="q-promo" data-exit-code hidden></p>
            <button class="q-next" type="button" data-exit-claim>Keep my 15% off</button>
          </div>
        </div>

        {/* Step 2 reward: a real scratch-off, drawn on canvas. */}
        <div class="q-modal" data-modal="scratch" hidden>
          <div class="q-modal-backdrop" data-modal-close></div>
          <div class="q-modal-panel" role="dialog" aria-modal="true" aria-labelledby="scratch-title">
            <button class="q-modal-x" type="button" data-modal-close aria-label="Close">&times;</button>
            <p class="q-modal-eyebrow">You've earned a scratch-off</p>
            <h2 class="q-modal-title" id="scratch-title">Scratch to reveal your discount.</h2>

            <div class="q-scratch">
              <div class="q-scratch-prize" data-scratch-prize>
                <span class="q-scratch-amount" data-scratch-amount>15% off</span>
                <span class="q-scratch-sub">your first project</span>
              </div>
              <canvas class="q-scratch-foil" data-scratch-canvas width="440" height="200"></canvas>
            </div>

            <p class="q-modal-copy" data-scratch-note>Drag across the panel to scratch it off.</p>
            <p class="q-promo" data-scratch-code hidden></p>
            <button class="q-next" type="button" data-scratch-claim hidden>
              Claim it and keep going
            </button>
          </div>
        </div>

        <aside class="q-proof">
          {testimonials.map((t, i) => (
            <figure class:list={['q-proof-quote', { active: i === 0 }]} data-proof-quote>
              <blockquote class="q-proof-text">“{t.quote}”</blockquote>
              <figcaption class="q-proof-credit">
                <span>{t.name}</span>
                <span class="q-proof-company">{t.company}</span>
              </figcaption>
            </figure>
          ))}
        </aside>

        {/* Under the gray card: the teal stat left (swapping in step with the
            active quote), the portfolio link right — together spanning the
            card's width. */}
        <div class="q-proof-foot">
          <div class="q-proof-stats">
            {testimonials.map((t, i) => (
              <p class:list={['q-proof-stat', { active: i === 0 }]} data-proof-stat>{t.stat}</p>
            ))}
          </div>
          <a class="q-proof-more" href="/portfolio">View our work</a>
        </div>
      </div>
    </main>

    <script define:vars={{ META_PIXEL_ID }}>
      // ----- Meta pixel ---------------------------------------------------
      // Injected only when an ID is configured; every call below no-ops
      // safely without it (or when the pixel is blocked).
      if (META_PIXEL_ID) {
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = true;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', META_PIXEL_ID);
        window.fbq('track', 'PageView');
      }

      function track(event, params) {
        if (!window.fbq) return;
        try {
          window.fbq('trackCustom', event, params);
        } catch (e) {
          /* tracking must never break the funnel */
        }
      }

      // ----- state machine ------------------------------------------------
      const main = document.querySelector('.q');
      const cards = [...document.querySelectorAll('.q-card')];
      const stepNum = document.querySelector('[data-step-num]');
      const segments = [...document.querySelectorAll('.q-progress-bar button')];
      const done = document.querySelector('.q-done');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let step = 1;
      const answers = { budget: '' };

      // ----- progressive save ---------------------------------------------
      // Every completed step posts what we have so far. The first post
      // creates the Airtable row and hands back its id; later steps update
      // that same row, so an abandoned funnel still leaves its answers
      // behind instead of vanishing.
      let recordId = '';
      // Saves run one at a time, chained: two steps answered in quick
      // succession must not race and create two rows before the first
      // response has handed back the id.
      let chain = Promise.resolve();

      function payload() {
        // Budget and any scratch-off prize share the Message column, so the
        // flow needs no new Airtable columns to start capturing.
        const notes = [];
        if (answers.budget) notes.push('Budget: ' + answers.budget);
        if (answers.prize) notes.push('Scratch-off: ' + answers.prize);
        if (answers.promo) notes.push('Promo code: ' + answers.promo);

        return {
          source: 'Get started',
          page: 'get-started',
          recordId,
          business: answers.industry ?? '',
          frustration: answers.challenge ?? '',
          message: notes.join(' | '),
          email: answers.email ?? '',
          phone: answers.phone ?? '',
        };
      }

      function save() {
        chain = chain.then(async () => {
          try {
            const res = await fetch('/api/lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload()),
            });
            const data = await res.json();
            if (data?.recordId) recordId = data.recordId;
          } catch (err) {
            console.error('Lead save failed', err);
          }
        });
        return chain;
      }

      function render() {
        main.dataset.step = String(step);
        cards.forEach((card) => {
          const active = Number(card.dataset.card) === step;
          card.hidden = !active;
          card.setAttribute('aria-hidden', String(!active));
        });
        stepNum.textContent = String(step);
        segments.forEach((seg, i) => seg.classList.toggle('done', i < step));
        const first = cards[step - 1]?.querySelector('input, textarea');
        if (first) first.focus({ preventScroll: true });
        track('GetStartedStep', { step });
        rotateProof();
      }

      // ----- floating proof -----------------------------------------------
      // A fresh quote on every step change, and a slow rotation while the
      // visitor thinks — the decision is always sitting next to a reason.
      const proofQuotes = [...document.querySelectorAll('[data-proof-quote]')];
      const proofStats = [...document.querySelectorAll('[data-proof-stat]')];
      let proofIndex = 0;
      let proofStarted = false;

      function showProof(i) {
        proofQuotes.forEach((q, j) => q.classList.toggle('active', j === i));
        proofStats.forEach((s, j) => s.classList.toggle('active', j === i));
      }

      function rotateProof() {
        // The initial render keeps quote 1; every later step change advances.
        if (!proofStarted) {
          proofStarted = true;
          return;
        }
        proofIndex = (proofIndex + 1) % proofQuotes.length;
        showProof(proofIndex);
      }

      window.setInterval(() => {
        proofIndex = (proofIndex + 1) % proofQuotes.length;
        showProof(proofIndex);
      }, 7000);

      // ----- option cards -------------------------------------------------
      // data-multi toggles; data-single selects and auto-advances.
      document.querySelectorAll('.q-options').forEach((group) => {
        const single = group.hasAttribute('data-single');
        group.querySelectorAll('.q-option').forEach((option) => {
          option.addEventListener('click', () => {
            if (single) {
              group.querySelectorAll('.q-option').forEach((o) => o.classList.remove('selected'));
              option.classList.add('selected');
              answers.budget = option.dataset.option;
              group.closest('.q-card').querySelector('[data-options-error]').textContent = '';
              window.setTimeout(next, reducedMotion ? 0 : 240);
            } else {
              option.classList.toggle('selected');
              const picked = [...group.querySelectorAll('.q-option.selected')];
              answers.goals = picked.map((o) => o.dataset.option);
              if (picked.length) {
                group.closest('.q-card').querySelector('[data-options-error]').textContent = '';
              }
            }
          });
        });
      });

      // ----- validation ---------------------------------------------------
      function validate(card) {
        let ok = true;
        for (const field of card.querySelectorAll('input, textarea')) {
          const error = field.closest('.q-field')?.querySelector('.q-error');
          let message = '';
          if (field.required && !field.value.trim()) {
            message = 'This one we need.';
          } else if (field.type === 'email' && field.value && !field.checkValidity()) {
            message = 'That email does not look right.';
          }
          if (error) error.textContent = message;
          field.setAttribute('aria-invalid', String(Boolean(message)));
          if (message && ok) {
            field.focus({ preventScroll: true });
            ok = false;
          }
        }
        return ok;
      }

      function store(card) {
        for (const field of card.querySelectorAll('input, textarea')) {
          answers[field.name] = field.value.trim();
        }
      }

      function next() {
        const card = cards[step - 1];
        if (!validate(card)) return;
        store(card);
        save(); // each step lands in Airtable as it is answered
        if (step < cards.length) {
          step += 1;
          render();
          if (step === 2) openScratch();
        }
      }

      function back() {
        if (step > 1) {
          step -= 1;
          render();
        }
      }

      // Jumping via the progress bars. Going back is always allowed; jumping
      // forward validates and stores each card on the way, so a skipped
      // answer still stops the visitor where it is missing.
      function goTo(target) {
        if (target === step) return;
        if (target < step) {
          store(cards[step - 1]);
          step = target;
          render();
          return;
        }
        while (step < target) {
          const card = cards[step - 1];
          if (!validate(card)) return;
          store(card);
          step += 1;
        }
        render();
      }

      // ----- finish: lead POST (fire-and-forget) + success ----------------
      function submit() {
        const card = cards[3];
        if (!validate(card)) return;
        store(card);

        save(); // final write: fills in the contact details on the same row

        if (window.fbq) {
          try {
            window.fbq('track', 'Lead', { content_name: 'get-started' });
          } catch (e) {
            /* never block the funnel */
          }
        }

        main.dataset.step = 'done';
        segments.forEach((seg) => seg.classList.add('done'));
        cards.forEach((c) => {
          c.hidden = true;
          c.setAttribute('aria-hidden', 'true');
        });
        done.hidden = false;
        done.setAttribute('aria-hidden', 'false');
      }

      document.querySelectorAll('[data-goto]').forEach((bar) => {
        bar.addEventListener('click', () => goTo(Number(bar.dataset.goto)));
      });

      // ----- modals --------------------------------------------------------
      const modals = {
        exit: document.querySelector('[data-modal="exit"]'),
        scratch: document.querySelector('[data-modal="scratch"]'),
      };

      function openModal(name) {
        modals[name].hidden = false;
      }

      function closeModal(el) {
        el.hidden = true;
      }

      document.querySelectorAll('[data-modal-close]').forEach((el) => {
        el.addEventListener('click', () => closeModal(el.closest('.q-modal')));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('.q-modal:not([hidden])').forEach(closeModal);
      });

      // ----- promo codes ----------------------------------------------------
      // ⚠ These strings must exist as PROMOTION CODES in Stripe, or checkout
      // will reject them. Create them there, then keep the two in sync.
      const PROMO = {
        '10% off': 'FPL10',
        '15% off': 'FPL15',
        '25% off': 'FPL25',
      };

      let claimedCode = '';

      // navigator.clipboard needs a secure context and can still be denied,
      // so fall back to a hidden textarea, and either way the code stays on
      // screen to be read.
      async function copyCode(code) {
        try {
          await navigator.clipboard.writeText(code);
          return true;
        } catch {
          try {
            const box = document.createElement('textarea');
            box.value = code;
            box.setAttribute('readonly', '');
            box.style.position = 'fixed';
            box.style.opacity = '0';
            document.body.appendChild(box);
            box.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(box);
            return ok;
          } catch {
            return false;
          }
        }
      }

      // Claim: copy the code, tell them what to do with it, and leave the
      // button as the way out of the modal.
      async function claim(code, codeEl, button, closingLabel) {
        claimedCode = code;
        answers.promo = code;
        const copied = await copyCode(code);

        codeEl.hidden = false;
        codeEl.innerHTML = copied
          ? '<span class="q-promo-code">' +
            code +
            '</span><br />Your promo code has been copied to your clipboard. Paste this as a promo code at Stripe checkout when you get there.'
          : '<span class="q-promo-code">' +
            code +
            '</span><br />Copy this promo code and paste it at Stripe checkout when you get there.';

        button.textContent = closingLabel;
        button.dataset.modalClose = '';
        button.addEventListener('click', () => closeModal(button.closest('.q-modal')), { once: true });
        track('GetStartedPromoClaimed', { code });
        save(); // the code rides along on the lead
      }

      document.querySelector('[data-exit-claim]').addEventListener(
        'click',
        (e) => {
          claim(
            PROMO['15% off'],
            document.querySelector('[data-exit-code]'),
            e.currentTarget,
            'Got it, keep going'
          );
        },
        { once: true }
      );

      // ----- exit intent ----------------------------------------------------
      // Fires once per visit, and never after the lead is in: the pointer
      // leaving through the top of the window is the desktop tell, and a tab
      // switch is the closest equivalent on a phone.
      let exitShown = false;
      let offerDeadline = 0;
      const landedAt = Date.now();

      function showExitOffer() {
        // A pointer that clips the top edge in the first seconds is usually
        // someone still arriving, not someone leaving.
        if (Date.now() - landedAt < 6000) return;
        if (exitShown || main.dataset.step === 'done') return;
        // Never stack on top of the scratch-off.
        if (!modals.scratch.hidden) return;
        exitShown = true;
        offerDeadline = Date.now() + 15 * 60 * 1000;
        openModal('exit');
        track('GetStartedExitOffer', { step });
        tickClock();
      }

      function tickClock() {
        const clock = document.querySelector('[data-exit-clock]');
        const left = Math.max(0, offerDeadline - Date.now());
        const m = Math.floor(left / 60000);
        const s = Math.floor((left % 60000) / 1000);
        clock.textContent = m + ':' + String(s).padStart(2, '0');
        if (left > 0) window.setTimeout(tickClock, 1000);
      }

      document.addEventListener('mouseout', (e) => {
        // relatedTarget null + leaving through the top edge = heading for the
        // tab bar or the close button.
        if (e.relatedTarget || e.clientY > 8) return;
        showExitOffer();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') showExitOffer();
      });

      // ----- scratch-off ----------------------------------------------------
      // Real scratching: a canvas of foil erased by the pointer, revealed
      // once enough of it is gone. The prize is drawn once, by chance.
      const PRIZES = [
        { label: '10% off', weight: 55 },
        { label: '15% off', weight: 30 },
        { label: '25% off', weight: 15 },
      ];

      let scratchReady = false;

      function drawPrize() {
        const total = PRIZES.reduce((sum, p) => sum + p.weight, 0);
        let roll = Math.random() * total;
        for (const prize of PRIZES) {
          roll -= prize.weight;
          if (roll <= 0) return prize.label;
        }
        return PRIZES[0].label;
      }

      function openScratch() {
        if (scratchReady) return;
        scratchReady = true;

        const prize = drawPrize();
        document.querySelector('[data-scratch-amount]').textContent = prize;
        answers.prize = prize;

        const canvas = document.querySelector('[data-scratch-canvas]');
        const wrap = canvas.closest('.q-scratch');
        const note = document.querySelector('[data-scratch-note]');
        const claimBtn = document.querySelector('[data-scratch-claim]');
        const codeEl = document.querySelector('[data-scratch-code]');

        claimBtn.addEventListener(
          'click',
          () => claim(PROMO[prize], codeEl, claimBtn, 'Got it, keep going'),
          { once: true }
        );
        const ctx = canvas.getContext('2d');

        // Foil: a flat silver ground with the site's cyan angled through it.
        const foil = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
        foil.addColorStop(0, '#c9ccd1');
        foil.addColorStop(0.45, '#e8eaec');
        foil.addColorStop(0.55, '#03f6ff');
        foil.addColorStop(1, '#b9bdc4');
        ctx.fillStyle = foil;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = 'rgb(0 0 0 / 45%)';
        ctx.font = '600 22px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('SCRATCH HERE', canvas.width / 2, canvas.height / 2 + 8);

        // Erasing is just drawing with destination-out.
        ctx.globalCompositeOperation = 'destination-out';

        let scratching = false;
        let revealed = false;

        function pointAt(e) {
          const rect = canvas.getBoundingClientRect();
          return {
            x: ((e.clientX - rect.left) / rect.width) * canvas.width,
            y: ((e.clientY - rect.top) / rect.height) * canvas.height,
          };
        }

        function scratch(e) {
          if (!scratching || revealed) return;
          const { x, y } = pointAt(e);
          ctx.beginPath();
          ctx.arc(x, y, 26, 0, Math.PI * 2);
          ctx.fill();
          checkCleared();
        }

        // Sampling every 8th pixel is plenty to know when a third is gone,
        // and keeps this cheap enough to run on every pointer move.
        function checkCleared() {
          const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
          let clear = 0;
          let total = 0;
          for (let i = 3; i < data.length; i += 32) {
            total += 1;
            if (data[i] === 0) clear += 1;
          }
          if (clear / total > 0.35) reveal();
        }

        function reveal() {
          if (revealed) return;
          revealed = true;
          wrap.classList.add('revealed');
          note.textContent = prize + ' is yours.';
          claimBtn.hidden = false;
          track('GetStartedScratch', { prize });
          save(); // the prize rides along on the next write
        }

        canvas.addEventListener('pointerdown', (e) => {
          scratching = true;
          canvas.setPointerCapture(e.pointerId);
          scratch(e);
        });
        canvas.addEventListener('pointermove', scratch);
        canvas.addEventListener('pointerup', () => {
          scratching = false;
        });
        canvas.addEventListener('pointercancel', () => {
          scratching = false;
        });

        // Keyboard and reduced-motion users get the prize without dragging.
        if (reducedMotion) reveal();

        openModal('scratch');
        track('GetStartedScratchOpen', {});
      }

      // ----- header strips ------------------------------------------------
      // One strip open at a time; clicking its button again closes it.
      const stripToggles = [...document.querySelectorAll('[data-strip-toggle]')];
      stripToggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const strip = document.querySelector(`[data-strip="${btn.dataset.stripToggle}"]`);
          const wasOpen = strip.classList.contains('open');
          document.querySelectorAll('.q-strip').forEach((s) => s.classList.remove('open'));
          stripToggles.forEach((b) => {
            b.classList.remove('open');
            b.setAttribute('aria-expanded', 'false');
          });
          if (!wasOpen) {
            strip.classList.add('open');
            btn.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // ----- wiring -------------------------------------------------------
      document.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', next));
      document.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', back));
      document.querySelector('[data-submit]').addEventListener('click', submit);

      cards.forEach((card, i) => {
        card.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' || e.shiftKey) return;
          if (e.target.matches('input, textarea')) {
            e.preventDefault();
            i === 3 ? submit() : next();
          }
        });
      });

      render();
    </script>

    <style>
      .q {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background-color: var(--color-white, #fff);
      }

      .q-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1.4rem 2rem;
      }

      .q-logo {
        display: inline-flex;
        flex: none;
      }

      .q-logo img {
        width: 180px;
        height: auto;
      }

      /* --- header mini buttons + drawer strips -----------------------------
         Sharp-edged, minimal — the site's bordered-row language, shrunk to a
         button. */

      .q-header-actions {
        display: flex;
        gap: 0.5rem;
      }

      .q-mini {
        border: 1px solid var(--color-border-muted);
        border-radius: 0;
        background: none;
        padding: 0.5rem 0.85rem;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-primary);
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.24s ease, color 0.24s ease, border-color 0.24s ease;
      }

      .q-mini:hover,
      .q-mini.open {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-white);
      }

      .q-mini:focus-visible {
        outline: 2px solid var(--fpl-blue);
        outline-offset: 2px;
      }

      /* 0fr → 1fr slides the strip open without measuring — the site's
         drawer trick. */
      .q-strip {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }

      .q-strip.open {
        grid-template-rows: 1fr;
      }

      .q-strip-clip {
        overflow: hidden;
      }

      .q-strip-content {
        margin: 0;
        padding: 0.7rem 2rem;
        background-color: var(--color-primary);
        color: var(--color-white);
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-align: right;
      }

      .q-strip-content a {
        color: var(--fpl-blue);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .q-strip-accent {
        color: var(--fpl-blue);
        font-weight: 600;
      }

      .q-body {
        flex: 1;
        width: 100%;
        max-width: 34rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
      }

      /* --- progress ------------------------------------------------------ */

      .q-progress {
        margin-bottom: 2.25rem;
      }

      .q-progress-label {
        display: block;
        margin-bottom: 0.6rem;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-secondary);
      }

      .q-progress-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.4rem;
      }

      /* The bar is 3px, but the button keeps a taller invisible hit area so
         it is tappable on a phone. */
      .q-progress-bar button {
        height: 3px;
        border: 0;
        border-radius: 0;
        padding: 0;
        background-color: var(--color-border-muted);
        background-clip: padding-box;
        border-top: 9px solid transparent;
        border-bottom: 9px solid transparent;
        box-sizing: content-box;
        margin-block: -9px;
        cursor: pointer;
        transition: background-color 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }

      .q-progress-bar button.done {
        background-color: var(--fpl-blue);
      }

      .q-progress-bar button:hover {
        background-color: var(--color-secondary);
      }

      .q-progress-bar button.done:hover {
        background-color: var(--color-primary);
      }

      .q-progress-bar button:focus-visible {
        outline: 2px solid var(--fpl-blue);
        outline-offset: 3px;
      }

      /* --- cards --------------------------------------------------------- */

      .q-card:not([hidden]),
      .q-done:not([hidden]) {
        animation: card-in 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
      }

      @keyframes card-in {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .q-question {
        margin: 0 0 0.6rem;
        font-family: var(--font-secondary);
        font-size: 2rem;
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.025em;
      }

      .q-helper {
        margin: 0 0 1.75rem;
        font-size: 1rem;
        line-height: 1.45;
        color: var(--color-secondary);
      }

      /* --- option cards ---------------------------------------------------
         The site's row treatment: bordered rows that fill black on hover and
         stay black once selected, plus that becomes a check. */

      .q-options {
        display: grid;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
      }

      .q-option {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        width: 100%;
        text-align: left;
        border: 1px solid var(--color-border-muted);
        background: none;
        padding: 1rem 1.15rem;
        font-size: 1.0625rem;
        font-weight: 500;
        letter-spacing: -0.019em;
        color: var(--color-primary);
        cursor: pointer;
        transition: background-color 0.24s ease, color 0.24s ease, border-color 0.24s ease;
      }

      .q-option:hover {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-white);
      }

      .q-option.selected {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: var(--color-white);
      }

      .q-option:focus-visible {
        outline: 2px solid var(--fpl-blue);
        outline-offset: 2px;
      }

      /* Plus that becomes a cyan check on selection: the two bars fade out
         and the box itself redraws as an L-shape rotated into a check. */
      .q-option-mark {
        position: relative;
        flex: none;
        width: 15px;
        height: 15px;
        border: 0 solid var(--fpl-blue);
        transition:
          transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94),
          border-width 0.2s ease,
          height 0.2s ease;
      }

      .q-option-mark::before,
      .q-option-mark::after {
        content: '';
        position: absolute;
        inset: 50% 0 auto 0;
        height: 1.5px;
        background-color: currentColor;
        transition: opacity 0.18s ease;
      }

      .q-option-mark::after {
        transform: rotate(90deg);
      }

      .q-option.selected .q-option-mark::before,
      .q-option.selected .q-option-mark::after {
        opacity: 0;
      }

      .q-option.selected .q-option-mark {
        height: 8px;
        border-left-width: 2.5px;
        border-bottom-width: 2.5px;
        transform: rotate(-45deg) translateY(-20%);
      }

      /* --- fields --------------------------------------------------------- */

      .q-field {
        display: grid;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
      }

      .q-field label {
        font-size: 0.875rem;
        font-weight: 500;
      }

      .q-field input,
      .q-field textarea {
        font: inherit;
        /* 16px exactly — below it iOS Safari force-zooms the page on focus. */
        font-size: 16px;
        color: var(--color-primary);
        background: none;
        border: 0;
        border-bottom: 1px solid var(--color-border-muted);
        padding: 0.45rem 0;
        border-radius: 0;
        resize: vertical;
        transition: border-color 0.2s ease;
      }

      .q-field input::placeholder,
      .q-field textarea::placeholder {
        color: var(--color-form-placeholder);
      }

      .q-field input:focus,
      .q-field textarea:focus {
        outline: none;
        border-bottom-color: var(--color-primary);
      }

      .q-error {
        margin: 0;
        min-height: 1em;
        font-size: 0.8125rem;
        color: #c0392b;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      /* --- nav buttons ---------------------------------------------------- */

      .q-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
      }

      .q-next {
        border: 1px solid var(--color-primary);
        border-radius: 999px;
        padding: 0.85rem 2.2rem;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background-color: var(--color-primary);
        color: var(--color-white);
        cursor: pointer;
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      .q-next:hover {
        background-color: transparent;
        color: var(--color-primary);
      }

      .q-next:focus-visible,
      .q-back:focus-visible {
        outline: 2px solid var(--fpl-blue);
        outline-offset: 2px;
      }

      .q-done-link {
        display: inline-flex;
        text-decoration: none;
      }

      .q-back {
        border: 0;
        background: none;
        padding: 0.5rem 0;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-secondary);
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .q-back:hover {
        color: var(--color-primary);
      }

      /* --- modals ---------------------------------------------------------- */

      .q-modal {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
      }

      .q-modal[hidden] {
        display: none;
      }

      .q-modal-backdrop {
        position: absolute;
        inset: 0;
        background-color: rgb(0 0 0 / 55%);
        animation: fade-in 0.24s ease both;
      }

      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      .q-modal-panel {
        position: relative;
        width: 100%;
        max-width: 30rem;
        background-color: var(--color-white);
        padding: 2rem 1.75rem 1.75rem;
        display: grid;
        gap: 0.85rem;
        justify-items: start;
        animation: card-in 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
      }

      .q-modal-x {
        position: absolute;
        top: 0.5rem;
        right: 0.75rem;
        border: 0;
        background: none;
        padding: 0.25rem;
        font-size: 1.5rem;
        line-height: 1;
        color: var(--color-secondary);
        cursor: pointer;
      }

      .q-modal-x:hover {
        color: var(--color-primary);
      }

      .q-modal-eyebrow {
        margin: 0;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-secondary);
      }

      .q-modal-title {
        margin: 0;
        font-family: var(--font-secondary);
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.025em;
      }

      .q-modal-copy {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.45;
        color: var(--color-secondary);
      }

      .q-modal-clock {
        font-weight: 600;
        color: var(--color-primary);
        font-variant-numeric: tabular-nums;
      }

      /* The copied promo code, shown so it can still be read (or retyped) if
         the clipboard write is blocked. */
      .q-promo {
        margin: 0;
        justify-self: stretch;
        border: 1px dashed var(--color-border-muted);
        background-color: var(--color-background-muted);
        padding: 0.75rem 0.9rem;
        font-size: 0.875rem;
        line-height: 1.45;
      }

      .q-promo[hidden] {
        display: none;
      }

      .q-promo-code {
        display: inline-block;
        font-family: var(--font-secondary);
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-primary);
      }

      /* --- scratch-off ------------------------------------------------------ */

      .q-scratch {
        position: relative;
        width: 100%;
        aspect-ratio: 44 / 20;
        margin: 0.35rem 0 0.25rem;
        background-color: var(--color-background-muted);
        overflow: hidden;
      }

      .q-scratch-prize {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 0.25rem;
        text-align: center;
      }

      .q-scratch-amount {
        font-family: var(--font-secondary);
        font-size: 2.75rem;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .q-scratch-sub {
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-secondary);
      }

      /* The foil sits over the prize until it is scratched away. */
      .q-scratch-foil {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        cursor: grab;
        touch-action: none;
        transition: opacity 0.4s ease;
      }

      .q-scratch-foil:active {
        cursor: grabbing;
      }

      .q-scratch.revealed .q-scratch-foil {
        opacity: 0;
        pointer-events: none;
      }

      /* --- floating proof -------------------------------------------------- */

      .q-proof {
        margin-top: 3rem;
        padding: 1.4rem 1.5rem;
        background-color: var(--color-background-muted);
        display: grid;
        animation: proof-float 5s ease-in-out infinite alternate;
      }

      @keyframes proof-float {
        from {
          transform: translateY(0);
        }
        to {
          transform: translateY(-7px);
        }
      }

      /* Quotes stack in the same cell and cross-fade. */
      .q-proof-quote {
        grid-area: 1 / 1;
        margin: 0;
        display: grid;
        gap: 0.75rem;
        opacity: 0;
        transition: opacity 0.6s ease;
        pointer-events: none;
      }

      .q-proof-quote.active {
        opacity: 1;
      }

      .q-proof-text {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.5;
        color: var(--color-primary);
      }

      .q-proof-foot {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-top: 0.7rem;
      }

      .q-proof-stats {
        display: grid;
        min-width: 0;
      }

      .q-proof-more {
        flex: none;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .q-proof-more:hover {
        color: var(--color-secondary);
      }

      .q-proof-stat {
        grid-area: 1 / 1;
        margin: 0;
        font-size: 0.9375rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--fpl-blue);
        opacity: 0;
        transition: opacity 0.6s ease;
      }

      .q-proof-stat.active {
        opacity: 1;
      }

      .q-proof-credit {
        display: grid;
        gap: 0.15rem;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .q-proof-company {
        color: var(--color-secondary);
      }

      /* --- responsive ------------------------------------------------------ */

      @media (max-width: 479px) {
        .q-question {
          font-size: 1.6rem;
        }

        /* The three buttons must still fit beside the logo on phones. */
        .q-header {
          padding: 1rem 1.25rem;
        }

        .q-logo img {
          width: 120px;
        }

        .q-header-actions {
          gap: 0.35rem;
        }

        .q-mini {
          padding: 0.45rem 0.55rem;
          font-size: 0.625rem;
          letter-spacing: 0.04em;
        }

        .q-strip-content {
          padding: 0.65rem 1.25rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .q-card:not([hidden]),
        .q-done:not([hidden]) {
          animation: none;
        }

        .q-progress-bar button {
          transition: none;
        }

        .q-proof {
          animation: none;
        }

        .q-proof-quote {
          transition: none;
        }
      }
    </style>
  </body>
</html>
