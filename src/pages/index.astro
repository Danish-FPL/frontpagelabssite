</style>

<script>
  import { wireLeadForm } from '../scripts/lead-form.js';

  // --- (05) Contact: posts as JSON to /api/lead (→ Airtable) ----------------
  wireLeadForm(document.querySelector('.home-contact-form'), { source: 'Home page' });

  // --- Drawers: client wins + the services accordion ------------------------
  //
  // Both use the same contract — a trigger carrying aria-expanded and an
  // `inert` panel next to it, with `.is-open` on the shared parent driving the
  // 0fr → 1fr height transition in CSS. Nothing here measures heights.

  function wire(items: NodeListOf<Element>, triggerSel: string, panelSel: string, single: boolean) {
    const entries = [...items].map((item) => ({
      item,
      trigger: item.querySelector<HTMLButtonElement>(triggerSel),
      panel: item.querySelector<HTMLElement>(panelSel),
    }));

    for (const entry of entries) {
      const { item, trigger, panel } = entry;
      if (!trigger || !panel) continue;

      trigger.addEventListener('click', () => {
        const open = trigger.getAttribute('aria-expanded') === 'true';

        // An accordion closes its siblings; the wins list lets rows stack.
        if (single && !open) {
          for (const other of entries) {
            if (other === entry || !other.trigger || !other.panel) continue;
            other.item.classList.remove('is-open');
            other.trigger.setAttribute('aria-expanded', 'false');
            other.panel.setAttribute('inert', '');
          }
        }

        item.classList.toggle('is-open', !open);
        trigger.setAttribute('aria-expanded', String(!open));
        if (open) panel.setAttribute('inert', '');
        else panel.removeAttribute('inert');
      });
    }
  }

  wire(document.querySelectorAll('[data-win]'), '[data-win-trigger]', '[data-win-panel]', false);
  wire(document.querySelectorAll('[data-svc]'), '[data-svc-trigger]', '[data-svc-panel]', true);

  // --- Services reveal ------------------------------------------------------
  //
  // Writes `--p` (0 → 1) on the section as it scrolls through its pinned
  // stage. The CSS does everything else. The media queries that unpin the
  // stage also pin --p at 1, so this is skipped below 992px and under reduced
  // motion rather than fighting them.

  const services = document.querySelector<HTMLElement>('[data-services]');
  const wide = window.matchMedia('(min-width: 992px)');
  const steady = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (services) {
    let queued = false;

    const update = () => {
      queued = false;
      if (!wide.matches || !steady.matches) {
        services.style.removeProperty('--p');
        return;
      }

      // The stage pins at section top = 0, so -top is how far into the pin we
      // are. One viewport of scroll opens the split; the rest of the section's
      // height is hold time.
      const top = services.getBoundingClientRect().top;
      const distance = window.innerHeight;
      const p = Math.min(Math.max(-top / distance, 0), 1);
      services.style.setProperty('--p', p.toFixed(4));
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    wide.addEventListener('change', onScroll);
    steady.addEventListener('change', onScroll);
    update();
  }
</script>
