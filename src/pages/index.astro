  /* --- (03) Approach ------------------------------------------------------- */

  .approach {
    padding-top: 6rem;
  }

  /*
   * The display block is the measuring stick for the words inside it. Sizing
   * the type in cqw (percent of THIS box) rather than vw ties it to the
   * container the rule above is drawn in, so ANALYZE. starts on that rule's
   * left end and BUILD. finishes on its right end at every width — where the
   * old vw sizing in a full-bleed wrapper ran past both. 17.5cqw holds the
   * cap-height the vw version had once the container stops growing at 80rem.
   */
  .approach-display {
    container-type: inline-size;
    overflow: hidden;
  }

  .approach-display .heading-large {
    font-size: 17.5cqw;
  }

  .approach-heading-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
