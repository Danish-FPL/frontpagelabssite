  .approach-number {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding-top: 0.4rem;
  }

  /* Grow. and the fingerprint share the last line. The word stays centred on
     the container — the left/right/centre stagger is the whole composition —
     and the mark is taken out of flow so it fills the empty right-hand end
     without pushing Grow. off centre. */
  .approach-grow-row {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Sized off the row's height, not its width: the mark is a 9:16 PNG, so a
     width big enough to read would stand taller than the line and collide
     with Build. above it. */
  /* Hangs below the line rather than above it — there is empty page under
     Grow. and Build. directly overhead. */
  .approach-image-inline {
    position: absolute;
    right: 0;
    top: 0;
    height: 132%;
    /* The mark's own 1080x1920 ratio, stated so the box has a width to shrink
       to; `width: auto` alone resolves to zero against a percentage height. */
    aspect-ratio: 1080 / 1920;
  }

  .approach-image-inline img {
    height: 100%;
    width: 100%;
    object-fit: contain;
    object-position: bottom right;
  }

  .approach-bottom {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
    margin-top: 3rem;
  }

  .approach-image img {
    width: 100%;
    display: block;
  }

  /* The stacked mark (tablet and phone) is a 9:16 portrait; uncapped it ran
     the full column width and stood ~700px tall on a phone. */
  .approach-image-stacked img {
    width: auto;
    max-height: 22rem;
  }

  .approach-text {
    display: grid;
    gap: 1rem;
    max-width: 30rem;
    justify-self: end;
  }

  /* Desktop: the mark is up beside Grow., so the copy takes the whole width
     and rides up under the words instead of sitting level with a tall image. */
  @media (min-width: 992px) {
    .approach-image-stacked {
      display: none;
    }

    .approach-bottom {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.75rem;
    }

    .approach-text {
      justify-self: end;
    }
  }

  @media (max-width: 991px) {
    .approach-image-inline {
      display: none;
    }
  }

  /* Not flex: the trailing full stop after the <strong> is its own text node,
     so a flex row made it a separate item and the gap pushed it off on its
     own — "Strategy guides design ." Inline keeps the sentence intact and the
     number is spaced by its own margin. */
  .approach-step {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: -0.019em;
  }

  .approach-step-number {
    display: inline-block;
    margin-right: 0.6rem;
    font-size: 0.6875rem;
    color: var(--color-secondary);
  }

  /* --- (04) Lab results ----------------------------------------------------- */

  .results {
    position: relative;
    color: var(--color-white);
    padding-block: 5rem 7rem;
    overflow: hidden;
  }

  .results-media {
    position: absolute;
    inset: 0;
  }

  .results-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The clip's top third is pale, and at 15% the white "Outcomes (04)" rule
     and heading sat on it at roughly 1.4:1. Floored at 45% so the type holds
     wherever the video happens to be in its loop. */
  .results-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 45%) 0%, rgb(0 0 0 / 78%) 65%);
  }

  .results-inner {
    position: relative;
    z-index: 1;
  }

  .section-title-row.inverse {
    border-bottom: 1px solid rgb(255 255 255 / 30%);
    padding-bottom: 0.75rem;
  }

  .results-heading {
    margin: 2rem 0 3rem;
  }

  /* A uniform grid, not the Webflow scatter. The staggered version put five
     cards at four different justify-self positions down a single column, which
     read as misalignment rather than as composition — and left most of the
     band empty. Four even columns for the four quotes: one full row, no
     orphan card, and the band is actually filled. */
  .results-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .result-card {
    margin: 0;
    padding: 1.35rem;
    background-color: var(--color-white);
    color: var(--color-primary);
    display: grid;
    gap: 1rem;
    /* Quote pinned to the top, credit to the bottom, so the cards line up
       across the row no matter how long each quote runs. */
    grid-template-rows: auto 1fr auto;
    align-content: start;
  }

  /* Card fills the cell; the teal stat sits under it, on the dark video
     ground where the color actually carries. */
  .result-cell {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.7rem;
  }

  .result-card-stat {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fpl-blue);
  }

  .result-card-head {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .result-card-mark {
    width: 21px;
    height: auto;
    flex: none;
    margin-top: 0.15rem;
  }

  .result-card-title {
    margin: 0;
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* This is the actual client testimonial — it was the smallest text on the
     page at 12px, and set in the muted grey on top of that. */
  .result-card-quote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-primary);
  }

  .result-card-credit {
    display: grid;
    gap: 0.15rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .result-card-credit .muted {
    color: var(--color-secondary);
  }

  /* --- (05) Contact ---------------------------------------------------------- */
  /* Field styles mirror /contact — Astro scopes styles per page, so the form
     furniture is duplicated here on purpose. */

  .home-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #23d100;
  }

  .home-contact-heading {
    margin: 0 0 1.25rem;
  }

  .home-contact-intro p {
    max-width: 22rem;
  }

  .home-contact-form {
    display: grid;
    gap: 1.5rem;
    max-width: 38rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .field input,
  .field textarea {
    font: inherit;
    /* 16px on the input itself: below that, iOS Safari force-zooms the
       viewport on focus and strands the user mid-form. */
    font-size: 16px;
    color: var(--color-primary);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-border-muted);
    padding: 0.5rem 0;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  .field input::placeholder,
  .field textarea::placeholder {
