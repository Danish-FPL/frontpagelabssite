  /* --- Responsive ----------------------------------------------------------- */

  /* Nothing to reveal without scroll animation — render the finished split. */
  @media (prefers-reduced-motion: reduce) {
    .services {
      --p: 1;
    }

    .services-scroll {
      height: auto;
    }

    .services-stage {
      position: static;
      height: 100vh;
    }

    .services-panel-inner {
      transform: none;
    }

    .wins-panel,
    .svc-panel {
