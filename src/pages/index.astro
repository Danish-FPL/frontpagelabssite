---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import LandingHero from '../components/LandingHero.astro';
import WorkMosaic from '../components/WorkMosaic.astro';
import { testimonials } from '../data/testimonials';
import { recentWork } from '../data/projects';
import { homeHero } from '../data/hero';

// The hero lives in src/data/hero.ts because the Hero Lab treats it as the
// locked baseline every landing-page variant inherits from.

// "Recent client wins" table — the CMS list rendered as expandable rows.
//
// ⚠ PLACEHOLDER COPY: `summary`, `stats` and `tags` below are stand-ins so the
// drawers have something to show. Replace them with the real case-study
// details. `href` points at the matching /projects/<slug> from
// src/data/projects.ts — those routes are not built yet (see README,
// "Not yet ported"), so the buttons 404 until the case-study pages exist.
const clientWins = [
  {
    win: 'Brand Launch; Blank Product Concept to Six-Figure Sales',
    client: 'New E-Commerce Brand',
    year: '2026',
    href: '/projects/gunderpants',
    summary:
      'A tactical apparel brand came to us with a product and nothing else: no name, no identity, no storefront. We built the brand system, the e-commerce site, and the paid social engine that carried it to six figures in its first year.',
    stats: [
      { value: '6 figures', label: 'First-year revenue' },
      { value: '0 → 1', label: 'Brand built from scratch' },
      { value: '4.1x', label: 'Blended ROAS' },
    ],
    tags: ['Branding', 'E-Commerce', 'Paid Social'],
  },
  {
    win: 'New Websites for Award-Winning Real Estate Developers',
    client: 'Real Estate Company',
    year: '2026',
    href: '/projects/ak',
    summary:
      'An award-winning custom home builder was sending seven-figure buyers to a site that undersold the work. We rebuilt around the portfolio itself, with property pages that load fast and read like a brochure.',
    stats: [
      { value: '3x', label: 'Inquiry volume' },
      { value: '<1.2s', label: 'Largest contentful paint' },
      { value: '12', label: 'Property pages shipped' },
    ],
    tags: ['Website', 'Ads', 'SEO'],
  },
  {
    win: "Building and Managing Real Estate Group's Property Sites and Ads",
    client: 'Real Estate Company',
    year: '2026',
    href: '/projects/khangroup-real-estate',
    summary:
      'A multi-property group needed every listing to have its own site and its own ad campaign, without a marketing hire per building. We built one template system and run the campaigns off it.',
    stats: [
      { value: '8', label: 'Property sites live' },
      { value: '−38%', label: 'Cost per lead' },
      { value: 'Ongoing', label: 'Campaign management' },
    ],
    tags: ['Website', 'Ads', 'Digital Strategy'],
  },
  {
    win: 'Brand Launch; Blank SAAS Concept to 2,200 Monthly Users',
    client: 'New Legal Research App',
    year: '2025',
    href: '/projects/gavvy',
    summary:
      'A legal research tool existed as a prototype and an idea. We named it, designed the marketing site, and built the content and acquisition loop that took it to 2,200 monthly users.',
    stats: [
      { value: '2,200', label: 'Monthly active users' },
      { value: '0 → 1', label: 'Brand and site' },
      { value: '9 mo', label: 'From launch' },
    ],
    tags: ['Branding', 'Website', 'Content'],
  },
  {
    win: 'Collecting 300 5-Star Google Reviews for Local Business',
    client: 'Massage Therapy Studio',
    year: '2025',
    href: '/projects/massage',
    summary:
      'A studio with great service and almost no reviews was invisible in local search. We built the review-collection loop into their post-appointment flow and let volume do the rest.',
    stats: [
      { value: '300', label: '5-star reviews' },
      { value: '#1', label: 'Local map pack' },
      { value: '4.9', label: 'Average rating' },
    ],
    tags: ['Review Growth', 'Local SEO', 'SMS'],
  },
  {
    win: 'Driving SAAS Subscription Sales via Socials & Ads with 8:1 ROAS',
    client: 'Online Marketplace App',
    year: '2025',
    href: '/projects/rankhero',
    summary:
      'A marketplace analytics tool was spending on ads that broke even. We rebuilt the creative, the targeting, and the landing pages behind them, and took the account to an 8:1 return.',
    stats: [
      { value: '8:1', label: 'Return on ad spend' },
      { value: '+214%', label: 'Subscription starts' },
      { value: '5', label: 'Creative concepts tested' },
    ],
    tags: ['Ads', 'Social Media', 'Content'],
  },
  {
    win: 'New Website and Search Ads for Therapy Practice',
    client: 'Therapy Provider',
    year: '2025',
    href: '/projects/therapy-provider',
    summary:
      'A therapy practice needed to fill a caseload without competing on price. We built a site that speaks to the client, not the clinician, and paired it with tightly-scoped search ads.',
    stats: [
      { value: 'Full', label: 'Caseload reached' },
      { value: '−45%', label: 'Cost per booking' },
      { value: '6 wk', label: 'To first full month' },
    ],
    tags: ['Website', 'Search Ads', 'Digital Strategy'],
  },
];

// Services (02) — the laptop still the section opens on. It starts full-bleed
// and narrows to the left half as the section pins; swapping the section's
// photo is this one line.
const SERVICES_MEDIA = '/assets/services-laptop.jpg';

// Services accordion (02).
const services = [
  {
    id: 'websites',
    title: 'Websites',
    body: "A weak website, or no website at all, can drive away customers and mute business growth. We design websites that don't just look good, they perform. Every layout, line, and interaction is built to engage. Designed with precision and optimized for speed, our sites become the foundation for everything your brand does online.",
    note: 'Websites starting at $900',
    items: ['Service Websites', 'Portfolio Websites', 'E-Commerce Websites', 'Storefront Websites', 'Customer Portals'],
  },
  {
    id: 'channels',
    title: 'Channels',
    body: 'We connect the dots. Social media, email, search engines, and beyond, all synced into one cohesive marketing system. Channels that operate in-sync communicate a clear, consistent message to your customers across all platforms. Every post, send, and update plays its part in a strategy engineered to expand your reach and deepen brand impact.',
    items: ['Social Media Marketing', 'SMS Marketing', 'Email Marketing', 'Google Business Listings', 'Local Business Directories', 'Service Debut Campaigns'],
  },
  {
    id: 'ads',
    title: 'Ads',
    body: "Your customers are searching for you online; but can they find you? Our targeted ad campaigns push your business to the top of search and land right in front of who you're trying to reach. From social to search, print to paid, our campaigns move in harmony: strategic, creative, and built to convert. Every channel works together to drive awareness and sales.",
    items: ['Social Media Ad Campaigns', 'Google Search Ads', 'E-Commerce Ads', 'Paid Search Ads', 'Print Campaigns', 'Email & SMS Marketing'],
  },
  {
    id: 'strategy',
    title: 'Strategy',
    body: 'A digital strategy is your roadmap to growth online.',
    questions: [
      '(How is your site built, and what should it say?)',
      '(Who are you reaching, and when?)',
      '(What content should you post, and how often?)',
      "(What's the right ad budget for launch and scale?)",
    ],
    bodyAfter: "Every decision, big or small, defines your brand's trajectory.",
    items: ['Brand Design & Messaging', 'Audience Targeting & Segmentation', 'Content Mapping', 'Creative Asset Planning & Design', 'Ad Funnel Architecture', 'Ad Budget Planning', 'Media Planning', 'Campaign Analytics'],
  },
];

---

<Base title="FrontPageLabs - Digital Performance, Down to a Science." overlayNav>
  <!-- Hero ---------------------------------------------------------------- -->
  <!-- Home only: the header floats on the photo and the hero owns the whole
       viewport. Landing pages keep the solid header above the fold. -->
  <LandingHero {...homeHero} fullBleed />

  <!-- (01) Results ---------------------------------------------------------- -->
  <section class="section results">
    {/* The same looping clip as the hero, dimmed so the cards stay readable. */}
    <div class="results-media">
      <video autoplay muted loop playsinline poster="/assets/fpl-38-.png">
        <source src="/assets/fpl-3-transcode.webm" type="video/webm" />
        <source src="/assets/fpl-3-transcode.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="results-inner">
      <div class="container">
        <div class="section-title-row inverse">
          <h2 class="section-title-text">Outcomes</h2>
          <div class="section-title-text">(01)</div>
        </div>

        <h3 class="heading-small results-heading"><span class="text-blue">Results</span></h3>

        <div class="results-cards">
          {testimonials.map(({ heading, quote, name, company, stat }, i) => (
            <div class="result-cell">
              <figure class:list={['result-card', `pos-${i + 1}`]}>
                <div class="result-card-head">
                  <img class="result-card-mark" src="/assets/fpl-14-.png" alt="" aria-hidden="true" />
                  <h4 class="result-card-title">
                    {heading[0]}<br />{heading[1]}
                  </h4>
                </div>
                <blockquote class="result-card-quote">{quote}</blockquote>
                <figcaption class="result-card-credit">
                  <span>{name}</span>
                  <span class="muted">{company}</span>
                </figcaption>
              </figure>
              {stat && <p class="result-card-stat">{stat}</p>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Recent client wins --------------------------------------------------- -->
  <section class="section wins">
    <div class="container">
      <div class="wins-grid">
        <h2 class="heading-small wins-heading">Recent<br />Client<br />Wins</h2>

        <div class="wins-table">
          {clientWins.map(({ win, client, year, href, summary, stats, tags }, i) => (
            <div class="wins-item" data-win>
              <button
                class="wins-row"
                type="button"
                id={`win-trigger-${i}`}
                aria-expanded="false"
                aria-controls={`win-panel-${i}`}
                data-win-trigger
              >
                <span class="wins-win">{win}</span>
                <span class="wins-client">{client}</span>
                <span class="wins-year">{year}</span>
                <span class="wins-toggle" aria-hidden="true"></span>
              </button>

              <div
                class="wins-panel"
                id={`win-panel-${i}`}
                role="region"
                aria-labelledby={`win-trigger-${i}`}
                inert
                data-win-panel
              >
                <div class="wins-panel-clip">
                  <div class="wins-panel-content">
                    <p class="wins-summary">{summary}</p>

                    <dl class="wins-stats">
                      {stats.map(({ value, label }) => (
                        <div class="wins-stat">
                          <dt class="wins-stat-value">{value}</dt>
                          <dd class="wins-stat-label">{label}</dd>
                        </div>
                      ))}
                    </dl>

                    <div class="wins-panel-foot">
                      <div class="wins-tags">
                        {tags.map((tag) => <span class="wins-tag">{tag}</span>)}
                      </div>
                      <Button href={href} label="View project" size="small" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Recent work ---------------------------------------------------------- -->
  <!-- Unnumbered like the wins table above it: the (0N) sequence belongs to
       the five pillar sections and this sits between two of them. -->
  <section class="section work">
    <div class="container">
      <div class="section-title-row">
        <h2 class="section-title-text">Recent work</h2>
        <div class="section-title-text">Selected projects</div>
      </div>
      <div class="divider"></div>

      <WorkMosaic projects={recentWork} />

      <div class="work-footer">
        <p class="work-footer-text">
          View More Projects<br /><span class="text-secondary">&amp; Client Success Stories</span>
        </p>
        <Button href="/portfolio" label="View all projects" />
      </div>
    </div>
  </section>

  <!-- (02) Digital chemistry ---------------------------------------------- -->
  <section class="section chemistry">
    <div class="container">
      <div class="chemistry-grid">
        <SectionTitle number="(02)" label="Digital Chemistry" />

        <div class="chemistry-content">
          <div class="margin-bottom-medium">
            <h2 class="heading-small">Form<br />and<br />function.</h2>
          </div>

          <div class="chemistry-body">
            <p class="paragraph-small no-text-indent">
              From <strong>sleek websites</strong> to <strong>full-scale marketing ecosystems</strong>, we
              blend art, outreach, and analytics to create digital experiences that <em>feel</em> as good
              as they perform.
            </p>
            <p class="paragraph-small no-text-indent">
              Every pixel, post and campaign is precision-built for audience engagement and consistent
              conversion.
            </p>
            <p class="paragraph-small no-text-indent"><strong>Welcome to the FrontPage.</strong></p>

            <div class="button-row">
              <Button href="/services" label="Services" />
            </div>
          </div>
        </div>

        <div class="chemistry-image">
          <img src="/assets/fpl-79-.png" alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- (03) Services -------------------------------------------------------- -->
  <!-- Scroll-driven split: the laptop still fills the section edge to edge, then
       narrows to the left half as the stage pins, uncovering the accordion
       panel beside it. `--p` (0 → 1) is written by the script at the bottom of
       this file; every transform here reads from it, so the whole reveal is one
       number. Under reduced motion, and on tablet/phone, the stage never pins
       and the section renders as a plain stacked layout. -->
  <section class="services" data-services>
    <div class="services-scroll">
      <div class="services-stage">
        <div class="services-media">
          <img src={SERVICES_MEDIA} alt="" loading="lazy" />
        </div>

        <div class="services-panel">
          <div class="services-panel-inner">
            <div class="services-head">
              <h2 class="section-title-text">Services</h2>
              <div class="section-title-text">(03)</div>
            </div>

            <div class="services-accordion">
              {services.map((service, i) => (
                <div class="svc" id={service.id} data-svc>
                  <h3 class="svc-heading">
                    <button
                      class="svc-trigger"
                      type="button"
                      id={`svc-trigger-${i}`}
                      aria-expanded="false"
                      aria-controls={`svc-panel-${i}`}
                      data-svc-trigger
                    >
                      <span class="svc-title">{service.title}</span>
                      <span class="svc-icon" aria-hidden="true"></span>
                    </button>
                  </h3>

                  <div
                    class="svc-panel"
                    id={`svc-panel-${i}`}
                    role="region"
                    aria-labelledby={`svc-trigger-${i}`}
                    inert
                    data-svc-panel
                  >
                    <div class="svc-panel-clip">
                      <div class="svc-panel-grid">
                        <div class="svc-copy">
                          <p class="svc-body">{service.body}</p>

                          {service.questions && (
                            <div class="svc-questions">
                              {service.questions.map((q) => <p class="svc-body">{q}</p>)}
                            </div>
                          )}

                          {service.bodyAfter && <p class="svc-body">{service.bodyAfter}</p>}

                          {service.note && <p class="svc-note">{service.note}</p>}
                        </div>

                        <ul class="svc-items">
                          {service.items.map((item) => (
                            <li class="svc-item">
                              <img src="/assets/check-white.svg" alt="" aria-hidden="true" />
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <div class="services-foot">
              <Button href="/services" label="View Services" variant="white" size="small" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- (04) Our approach ---------------------------------------------------- -->
  <section class="section approach">
    <div class="container">
      <div class="section-title-row">
        <h2 class="section-title-text">Our approach</h2>
        <div class="section-title-text">(04)</div>
      </div>
      <div class="divider"></div>
    </div>

    <!-- The three words sit in the same .container as the rule above them, and
         the type is sized in cqw rather than vw, so ANALYZE. lands flush with
         the ends of that rule at every width instead of running past it. -->
    <div class="container approach-display">
      <div class="approach-heading-wrapper">
        <h3 class="heading-large">Analyze.</h3>
        <div class="approach-number">001</div>
      </div>

      <div class="align-right">
        <div class="approach-heading-wrapper">
          <div class="approach-number left">002</div>
          <h3 class="heading-large">Build.</h3>
        </div>
      </div>

      <!-- Grow. keeps the fingerprint company on desktop; below 992px the mark
           drops back under the copy where there is room for it. -->
      <div class="approach-grow-row">
        <div class="approach-heading-wrapper">
          <h3 class="heading-large">Grow.</h3>
          <div class="approach-number">003</div>
        </div>

        <div class="approach-image approach-image-inline">
          <img src="/assets/fpl-16-.png" alt="" loading="lazy" />
        </div>
      </div>
    </div>

    <div class="container">
      <div class="approach-bottom">
        <div class="approach-image approach-image-stacked">
          <img src="/assets/fpl-16-.png" alt="" loading="lazy" />
        </div>

        <div class="approach-text">
          <p class="paragraph-small no-text-indent">
            Building your unique digital brand starts with analysis.
          </p>
          <p class="paragraph-small">
            We dissect your industry's growth engines, expose untapped opportunity, then shape a unique
            digital presence that fits perfectly into your market's next wave of opportunity.
          </p>
          <p class="approach-step"><span class="approach-step-number">004</span><strong>Strategy guides design</strong>.</p>
          <p class="approach-step"><span class="approach-step-number">005</span><strong>Design drives performance</strong>.</p>
          <p class="paragraph-small no-text-indent">
            <strong>The Outcome:</strong><br />
            Fine-tuned marketing elements that react in perfect chemistry to showcase your brand.
          </p>

          <div class="button-row">
            <Button href="/get-started" label="Get started" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- (05) Contact ----------------------------------------------------------- -->
  <!-- Minimal version of the /contact form: same fields, same /api/lead →
       Airtable pipeline via lead-form.js, just without the optional field
       and surrounding furniture. -->
  <section class="section home-contact">
    <div class="container">
      <div class="section-title-row">
        <h2 class="section-title-text">Contact</h2>
        <div class="section-title-text">(05)</div>
      </div>
      <div class="divider"></div>

      <div class="home-contact-grid">
        <div class="home-contact-intro">
          <div class="availability">
            <span class="availability-dot" aria-hidden="true"></span>
            <span>Available to take on new clients</span>
          </div>

          <h3 class="heading-small home-contact-heading">Let's<br />build.</h3>

          <p class="paragraph-small no-text-indent">
            <strong>Tell us a bit about your business and marketing goals</strong>, and we'll get in
            touch with you shortly.
          </p>
        </div>

        <form class="home-contact-form" name="home-contact">
          <div class="field">
            <label for="hc-name">Name:</label>
            <input id="hc-name" name="name" type="text" placeholder="Enter your name" required />
          </div>

          <div class="field">
            <label for="hc-email">Email:</label>
            <input id="hc-email" name="email" type="email" placeholder="Enter your email" required />
          </div>

          <div class="field">
            <label for="hc-business">Business Details:</label>
            <textarea
              id="hc-business"
              name="business"
              rows="3"
              placeholder="Please include some details about your business and marketing goals."
              required></textarea>
          </div>

          <p class="form-error" data-lead-error hidden>
            That didn't send. Try again, or email build@frontpagelabs.com.
          </p>
          <button class="submit-button" type="submit">Send Message</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The hero's styles live in src/components/LandingHero.astro — it is shared
     with the /lp/* landing pages. */

  /* --- Shared section furniture ------------------------------------------ */

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .divider {
    height: 1px;
    background-color: var(--color-border-muted);
  }

  .button-row {
    margin-top: 1.5rem;
  }

  .text-secondary {
    color: var(--color-secondary);
  }

  /* --- (01) Chemistry ----------------------------------------------------- */

  .chemistry-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.66fr);
    gap: 2.5rem;
    align-items: start;
  }

  .chemistry-body {
    display: grid;
    gap: 1rem;
    max-width: 30rem;
  }

  .chemistry-image img {
    width: 100%;
  }

  /* --- Recent client wins -------------------------------------------------- */

  .wins-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .wins-heading {
    margin: 0;
  }

  .wins-table {
    border-top: 1px solid var(--color-border-muted);
  }

  .wins-item {
    border-bottom: 1px solid var(--color-border-muted);
  }

  /* The row itself is the drawer trigger. Hovering or opening it fills the
     whole row black — the treatment the live site uses on row hover. */
  /* Sized off the live site: ~26px type on a ~104px row, the win column a
     shade narrower than the client column. */
  .wins-row {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr) auto auto;
    gap: 1.25rem;
    align-items: start;
    text-align: left;
    padding: 1.4rem 1.15rem;
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.021em;
    transition: background-color 0.28s ease, color 0.28s ease;
  }

  .wins-row:hover,
  .wins-item.is-open .wins-row {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .wins-row:focus-visible {
    outline: 2px solid var(--fpl-blue);
    outline-offset: -2px;
  }

  .wins-client,
  .wins-year {
    color: var(--color-secondary);
    transition: color 0.28s ease;
  }

  .wins-row:hover .wins-client,
  .wins-row:hover .wins-year,
  .wins-item.is-open .wins-client,
  .wins-item.is-open .wins-year {
    color: var(--color-white);
  }

  /* Plus that becomes a minus — two bars, one rotated away on open. */
  .wins-toggle {
    position: relative;
    width: 17px;
    height: 17px;
    margin-top: 0.3em;
    flex: none;
  }

  .wins-toggle::before,
  .wins-toggle::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .wins-toggle::after {
    transform: rotate(90deg);
  }

  .wins-item.is-open .wins-toggle::after {
    transform: rotate(0deg);
  }

  /* 0fr → 1fr animates the drawer open without measuring anything in JS. */
  .wins-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .wins-item.is-open .wins-panel {
    grid-template-rows: 1fr;
  }

  .wins-panel-clip {
    overflow: hidden;
  }

  .wins-panel-content {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem 1.5rem 2rem;
    background-color: var(--color-background-muted);
  }

  .wins-summary {
    margin: 0;
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    letter-spacing: -0.019em;
  }

  .wins-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0;
  }

  .wins-stat-value {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .wins-stat-label {
    margin: 0.35rem 0 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .wins-panel-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .wins-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .wins-tag {
    border: 1px solid var(--color-border-muted);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }


  /* --- (02) Services ------------------------------------------------------- */

  .services {
    /* `--p` is the reveal progress, 0 → 1, written by the script below. */
    --p: 0;
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  /* The extra height is the scroll budget the pinned stage spends: roughly one
     viewport to open the split, the rest as hold so the accordion is usable
     while the section is still pinned. */
  .services-scroll {
    height: 220vh;
  }

  .services-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  /* Full-bleed at --p:0, half the stage at --p:1. It sits above the panel, so
     narrowing it is what uncovers the accordion. */
  .services-media {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 2;
    width: calc(100% - var(--p) * 50%);
  }

  /* The photo is 4:5 but the frame it sits in swings from ~16:10 (full bleed)
     to ~4:5 (the half pane), so a fixed crop can't serve both: centred at full
     bleed you land in the middle of the screen's gradient and lose the
     laptop's shape entirely. The crop rides `--p` alongside the width — biased
     high while the frame is wide so the top bezel and corner stay in shot,
     easing back to centre as the frame narrows to the photo's own ratio. */
  .services-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center calc(28% + var(--p) * 22%);
  }

  .services-panel {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 1;
    width: 50%;
    display: flex;
  }

  .services-panel-inner {
    width: 100%;
    max-height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    padding: 3.5rem var(--container-padding) 3rem;
    /* Both clamp on their own: opacity to 0–1, and the offset resolves to 0
       once --p passes 1. */
    opacity: calc((var(--p) - 0.4) * 2.4);
    transform: translateX(calc((1 - var(--p)) * 2.5rem));
  }

  .services-panel-inner::-webkit-scrollbar {
    display: none;
  }

  .services-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 30%);
    margin-bottom: 2.5rem;
  }

  /* --- Services accordion --------------------------------------------------- */

  .svc-heading {
    margin: 0;
  }

  .svc-trigger {
    width: 100%;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
    padding: 0;
    color: var(--color-white);
    transition: color 0.3s ease;
  }

  .svc-title {
    font-family: var(--font-secondary);
    font-size: 3.9vw;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  /* Open heading drops back to grey so the body copy under it leads. */
  .svc.is-open .svc-trigger {
    color: var(--color-secondary);
  }

  .svc-trigger:focus-visible {
    outline: 2px solid var(--fpl-blue);
    outline-offset: 4px;
  }

  /* White disc with a dark plus that loses its upright bar on open. */
  .svc-icon {
    position: relative;
    flex: none;
    width: 1.05vw;
    min-width: 13px;
    aspect-ratio: 1;
    margin-top: 0.35em;
    border-radius: 50%;
    background-color: var(--color-white);
  }

  .svc-icon::before,
  .svc-icon::after {
    content: '';
    position: absolute;
    inset: 50% 22% auto 22%;
    height: 1.5px;
    background-color: var(--color-primary);
    transition: transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .svc-icon::after {
    transform: rotate(90deg);
  }

  .svc.is-open .svc-icon::after {
    transform: rotate(0deg);
  }

  .svc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .svc.is-open .svc-panel {
    grid-template-rows: 1fr;
  }

  .svc-panel-clip {
    overflow: hidden;
  }

  .svc-panel-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    gap: 2rem;
    padding: 1.25rem 0 1.75rem;
  }

  .svc-copy {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .svc-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    letter-spacing: -0.019em;
  }

  .svc-questions {
    display: grid;
    gap: 0.25rem;
    color: var(--color-secondary);
  }

  .svc-note {
    margin: 0.25rem 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.019em;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .svc-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .svc-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    letter-spacing: -0.019em;
  }

  .svc-item img {
    width: 12px;
    height: 12px;
    flex: none;
  }

  .services-foot {
    margin-top: 2.5rem;
  }

  /* --- Recent work --------------------------------------------------------- */

  .work {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  /* One portfolio CTA closes the wins table + mosaic pair. The wins table used
     to carry its own copy of this, so two identical buttons sat 900px apart. */
  .work-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-top: 3rem;
