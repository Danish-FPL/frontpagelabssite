  }

  @media (max-width: 991px) {
    .chemistry-grid {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .home-contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .results-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .chemistry-image {
