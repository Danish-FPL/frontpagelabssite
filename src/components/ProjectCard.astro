---
// A single portfolio tile: image, hover title overlay, and the tag row beneath.
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a class="project-link" href={project.href}>
  <div class="project-image-wrapper">
    <img class="project-image" src={project.image} alt={project.title} loading="lazy" />
  </div>

  <div class="project-content-top">
    <div class="project-title">{project.title}</div>
    <img class="project-arrow" src="/assets/arrow-up-right.svg" alt="" aria-hidden="true" />
  </div>

  <div class="project-content-footer">
    {project.tags.map((tag) => (
      <div class="project-label"><div class="project-label-text">{tag}</div></div>
    ))}
  </div>
</a>

<style>
  .project-link {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-muted);
  }

  /* Title sits above the image in the Webflow layout, with a hairline under it. */
  .project-content-top {
    order: -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
  }

  .project-title {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-arrow {
    width: 9px;
    height: 9px;
    transition: transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .project-link:hover .project-arrow {
    transform: translate(2px, -2px);
  }

  .project-image-wrapper {
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .project-link:hover .project-image {
    transform: scale(1.04);
  }

  .project-content-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.7rem 0.85rem;
  }

  .project-label {
    border: 1px solid var(--color-border-muted);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  .project-label-text {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }
</style>
