---
// The vertical section marker running up the left edge: "(01)" above a
// rotated label and a hairline rule.
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
---

<div class="title-vertical-wrapper">
  <div class="number-vertical">{number}</div>
  <h2 class="title-vertical section-title-text">{label}</h2>
  <div class="divider-vertical"></div>
</div>

<style>
  .title-vertical-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    align-self: stretch;
  }

  .number-vertical {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .title-vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .divider-vertical {
    flex: 1;
    width: 1px;
    min-height: 3rem;
    background-color: var(--color-border-muted);
  }

  @media (max-width: 767px) {
    .title-vertical-wrapper {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .number-vertical,
    .title-vertical {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .divider-vertical {
      width: auto;
      height: 1px;
      min-height: 0;
      align-self: center;
    }
  }
</style>
